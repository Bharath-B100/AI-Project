# System Environment Variables

# Database Configurations
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aipm_db
DB_USER=aipm_user
DB_PASSWORD=aipm_password

# JWT Security
JWT_SECRET=your_super_secret_high_entropy_signing_key_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000

# LLM Config (Spring AI)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o
