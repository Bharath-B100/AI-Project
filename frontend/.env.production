# Production environment variables for the Vite frontend build on Render.
# This file is NOT secret (it's baked into the JS bundle at build time).
#
# IMPORTANT: Replace the placeholder URL below with your actual Render backend URL
# after deploying the backend service. It will look like:
# https://aipm-backend.onrender.com
#
# You can also set this as a Render environment variable (VITE_API_BASE_URL)
# instead of editing this file.
VITE_API_BASE_URL=https://aipm-backend.onrender.com
